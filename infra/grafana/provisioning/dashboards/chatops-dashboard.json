      ]
    },
    {
      "title": "Application Errors Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(app_errors_total[1m]))",
          "legendFormat": "{{service}} errors"
        }
      ]
    },
    {
